# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Authentication
JWT_SECRET_KEY=replace_with_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Database (SQLite for development; Azure SQL planned for deployment)
DATABASE_URL=sqlite:///data/local_dev.db

# SEC EDGAR
SEC_USER_AGENT=replace_with_name_and_contact_email
SEC_REQUESTS_PER_SECOND=5

# NewsData.io
NEWSDATA_API_KEY=replace_with_api_key

# LLM provider
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=replace_with_api_key

# Azure (production)
AZURE_KEY_VAULT_URL=replace_with_key_vault_url
APPLICATIONINSIGHTS_CONNECTION_STRING=replace_with_connection_string
